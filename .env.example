# Neon / PostgreSQL Database Connection URL
DATABASE_URL="postgresql://username:password@your-postgres-host.tech/neondb?sslmode=require"

# Backblaze B2 Cloud Storage Configuration
B2_ENDPOINT="s3.us-east-005.backblazeb2.com"
B2_BUCKET_NAME="your-b2-bucket-name"
B2_KEY_ID="your-b2-key-id"
B2_APP_KEY="your-b2-app-key"

# Cloudflare Worker CDN Base URL
CDN_BASE_URL="https://your-worker-subdomain.workers.dev"

# Authentication & Streaming Security
JWT_SECRET="your-32-character-secret-key-goes-here"
JWT_REFRESH_SECRET="your-32-character-refresh-secret-here"
HMAC_SECRET_KEY="your-hmac-streaming-signature-secret"
